diff --git a/fs/exec_timing.h b/fs/exec_timing.h
new file mode 100644
index 000000000..a0876fd95
--- /dev/null
+++ b/fs/exec_timing.h
@@ -0,0 +1,58 @@
+#ifndef _EXEC_TRACE_H
+#define _EXEC_TRACE_H
+
+#include <linux/types.h>
+
+/*
+ * Function hook types
+ * These define the signature of tracing callbacks
+ */
+typedef void (*exec_trace_enter_t)(const char *func);
+typedef void (*exec_trace_exit_t)(const char *func);
+
+
+/*
+ * Global hook pointers
+ * These are defined in a kernel .c file and exported
+ * so a module can modify them at runtime.
+ */
+extern exec_trace_enter_t exec_trace_enter_hook;
+extern exec_trace_exit_t  exec_trace_exit_hook;
+
+
+/*
+ * Lightweight inline wrappers used by kernel code.
+ * They check whether a module has attached a hook.
+ */
+
+static inline void trace_exec_enter(const char *func)
+{
+    exec_trace_enter_t fn;
+
+    /* Read pointer once to avoid race */
+    fn = exec_trace_enter_hook;
+
+    if (unlikely(fn))
+        fn(func);
+}
+
+static inline void trace_exec_exit(const char *func)
+{
+    exec_trace_exit_t fn;
+
+    fn = exec_trace_exit_hook;
+
+    if (unlikely(fn))
+        fn(func);
+}
+
+
+/*
+ * Convenience macros
+ * Automatically capture the current function name.
+ */
+
+#define TRACE_EXEC_START()  trace_exec_enter(__func__)
+#define TRACE_EXEC_END()    trace_exec_exit(__func__)
+
+#endif /* _EXEC_TRACE_H */
